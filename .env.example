# Do NOT place real keys or real-money RPC credentials in this project.
NODE_ENV=development
HOST=127.0.0.1
AGENT_PORT=3000
VERIFIER_PORT=3001
REGISTRY_PORT=3002
ISSUER_PORT=3003
STATE_DIR=.state
# node scripts/dev.ts always forces development simulation and SQLite.
# A separately configured integration deployment may use these adapters:
# DATABASE_URL=postgresql://agentproof:change-me@localhost:5432/agentproof
# RPC_URL=http://127.0.0.1:8545
# CHAIN_ID=31337
# REGISTRY_ADDRESS=0x...
# ERC8004_FILTER_ENABLED=true
# A2A_FILTER_ENABLED=true
# APS_FILTER_ENABLED=true
# COMPANY_FILTER_ENABLED=true
# TAP_FILTER_ENABLED=true

# Real Ethereum Sepolia mode (copy only these lines to .env.sepolia if overriding defaults).
# Never place a wallet private key or seed phrase here.
# SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# AGENT_OWNER_ADDRESS=0x422A6dDB79F4a13B58f7aAedD92f464c3e1e70A9
# AGENT_PUBLIC_ORIGIN=https://psj224535.github.io/Agent-proof
# SEPOLIA_STATE_DIR=.state-sepolia
# SEPOLIA_AGENT_PORT=3100
# SEPOLIA_VERIFIER_PORT=3101
# SEPOLIA_CONFIRMATIONS=0
