# Do NOT place real keys or real-money RPC credentials in this project.
NODE_ENV=development
HOST=127.0.0.1
AGENT_PORT=3000
VERIFIER_PORT=3001
REGISTRY_PORT=3002
ISSUER_PORT=3003
STATE_DIR=.state
# node scripts/dev.ts always forces development simulation and SQLite.
# A separately configured integration deployment may use these adapters:
# DATABASE_URL=postgresql://agentproof:change-me@localhost:5432/agentproof
# RPC_URL=http://127.0.0.1:8545
# CHAIN_ID=31337
# REGISTRY_ADDRESS=0x...
# ERC8004_FILTER_ENABLED=true
# A2A_FILTER_ENABLED=true
# APS_FILTER_ENABLED=true
# COMPANY_FILTER_ENABLED=true
# TAP_FILTER_ENABLED=true
