{
  "name": "agentproof-authentication-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "start": "node --experimental-strip-types scripts/dev.ts",
    "start:sepolia": "node --experimental-strip-types scripts/sepolia.ts",
    "test": "node --experimental-strip-types --test --test-concurrency=1 tests/*.test.ts",
    "test:e2e": "node --experimental-strip-types scripts/http-e2e.ts",
    "admin-token": "node --experimental-strip-types scripts/admin-token.ts",
    "admin-token:sepolia": "SEPOLIA_STATE_DIR=.state-sepolia STATE_DIR=.state-sepolia node --experimental-strip-types scripts/admin-token.ts",
    "typecheck": "node tools/typecheck/node_modules/typescript/bin/tsc --noEmit --typeRoots tools/typecheck/node_modules/@types",
    "check:sepolia": "node --experimental-strip-types scripts/check-sepolia.ts",
    "docs:api": "node --experimental-strip-types scripts/generate-openapi.ts",
    "manifest": "node --experimental-strip-types scripts/generate-manifest.ts",
    "contracts:build": "node --experimental-strip-types scripts/contracts-build.ts",
    "contracts:test": "forge test --root contracts -v",
    "start:trade-demo": "node --experimental-strip-types scripts/trade-demo.ts",
    "test:trade": "node --experimental-strip-types --test tests/trading*.test.ts && node --experimental-strip-types scripts/trade-service-e2e.ts && node --experimental-strip-types scripts/exchange-service-e2e.ts",
    "check:trade-sepolia": "node --experimental-strip-types scripts/check-trade-sepolia.ts",
    "verify:trade-sepolia": "node --experimental-strip-types scripts/verify-trade-sepolia.ts",
    "test:exchange:service": "node --experimental-strip-types scripts/exchange-service-e2e.ts"
  }
}
