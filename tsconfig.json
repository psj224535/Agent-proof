{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": [
      "ES2024",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "verbatimModuleSyntax": true
  },
  "include": [
    "packages/**/*.ts",
    "services/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "types/**/*.d.ts"
  ]
}
